{
    "name": "liquidstack/core",
    "description": "Core de arranque, routing y helpers para el framework Liquid Stack (repositorio: liquidstack-core). Incluye módulos JS/SCSS con animaciones GSAP",
    "type": "composer-plugin",
    "license": "MIT",
    "homepage": "https://github.com/LiquidArtDevelopers/liquidstack-core",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "symfony/filesystem": "^6.4"
    },
    "require-dev": {
        "composer/composer": "^2.7",
        "phpunit/phpunit": "^10.5",
        "symfony/process": "^6.4 || ^7.0"
    },
    "replace": {
        "liquidstack/webadmin": "self.version",
        "liquidstack/blog": "self.version"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "src/Core/"
        },
        "files": [
            "src/Core/Support/helpers.php"
        ]
    },
    "scripts": {
        "release": [
            "App\\Core\\Composer\\ReleaseScript::run"
        ],
        "test": [
            "@php vendor/bin/phpunit --configuration phpunit.xml.dist --do-not-cache-result"
        ],
        "test:module-e2e": [
            "@php tools/test-module-composer-e2e.php"
        ],
        "liquidstack-core:sync-resources": [
            "App\\Core\\Composer\\Installer::syncResources"
        ],
        "liquidstack-core:sync-frontend-deps": [
            "App\\Core\\Composer\\Installer::syncFrontendDependencies"
        ]
    },
    "extra": {
        "class": "App\\Core\\Composer\\Plugin",
        "repository_name": "liquidstack-core"
    },
    "support": {
        "source": "https://github.com/LiquidArtDevelopers/liquidstack-core",
        "issues": "https://github.com/LiquidArtDevelopers/liquidstack-core/issues"
    }
}
