{
    "schema": 1,
    "id": "blog",
    "package": "liquidstack/blog",
    "requires": [
        "webadmin"
    ],
    "providers": {
        "routes": [
            "App\\Core\\Modules\\Blog\\BlogRouteProvider",
            "App\\Core\\Modules\\Blog\\BlogCategoryRouteProvider",
            "App\\Core\\Modules\\Blog\\BlogPublicRouteProvider"
        ],
        "middleware": [],
        "services": [],
        "navigation": [
            "App\\Core\\Modules\\Blog\\BlogWebAdminNavigationProvider",
            "App\\Core\\Modules\\Blog\\BlogCategoryWebAdminNavigationProvider"
        ],
        "capabilities": [],
        "migrations": [
            "App\\Core\\Modules\\Blog\\BlogMigrationProvider"
        ],
        "sitemap": []
    },
    "project_files": [
        {
            "source": "published/assets",
            "target": "public/assets/modules/blog",
            "type": "dir",
            "policy": "managed_hash"
        }
    ]
}
